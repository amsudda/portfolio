# Public URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database — a local SQLite file by default. For production use Turso (libsql://…)
# and set DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/idearigs.db
DATABASE_AUTH_TOKEN=

# Signs admin session cookies. Required in production, min 32 chars.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# First admin account, created by `npm run db:seed` (or use `npm run admin:create`).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Ishara W.
ADMIN_TITLE=Creative Director

# Where uploaded media is stored on disk (served from /media/*).
UPLOAD_DIR=./storage/uploads

# Optional: email a notification for every new enquiry via Resend.
RESEND_API_KEY=
ENQUIRY_NOTIFY_TO=hello@idearigs.lk
ENQUIRY_NOTIFY_FROM=Idearigs Website <website@idearigs.lk>
