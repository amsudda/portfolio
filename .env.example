# Copy to .env for local dev (optional) and set these in Coolify for production.

# PostgreSQL connection string. When set, the app uses Postgres.
# When UNSET (e.g. local dev), the app falls back to a JSON file at .data/projects.json.
# Coolify Postgres gives you this value.
DATABASE_URL=postgres://user:password@host:5432/portfolio

# Admin panel password (used at /admin). Change this!
ADMIN_PASSWORD=change-this-password

# Secret used to sign the admin session cookie. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-this-to-a-long-random-string

# Where the JSON-file fallback stores data when DATABASE_URL is not set.
# Not needed in production (Postgres is used instead).
# DATA_DIR=.data
